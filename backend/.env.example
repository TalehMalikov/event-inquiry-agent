OPENAI_API_KEY=
# Password the venue owner uses to log in
OWNER_PASSWORD=change-me
# Long random string used to sign login cookies (generate one, keep it secret)
SESSION_SECRET=change-me-to-a-long-random-string
DATABASE_URL=postgresql+psycopg://inbox:inbox@localhost:5433/inbox
CHAT_MODEL=gpt-4.1-mini
# Set to true when served over HTTPS (production)
COOKIE_SECURE=false
