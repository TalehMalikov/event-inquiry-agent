OPENAI_API_KEY=
DATABASE_URL=postgresql+psycopg://inbox:inbox@localhost:5433/inbox
CHAT_MODEL=gpt-4.1-mini
# Clerk login (Vercel -> events-frontend -> Settings -> Environment Variables, or Clerk dashboard)
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Sites allowed to use login tokens (comma separated)
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
# Max AI drafts per company per day
DAILY_DRAFT_LIMIT=50
# Gmail (Google Cloud: OAuth client + Pub/Sub topic)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PROJECT_ID=
GMAIL_PUBSUB_TOPIC=gmail-push
# Secret in the Pub/Sub push URL: /api/gmail/push?token=...
GMAIL_PUSH_TOKEN=
# Encrypts stored mailbox tokens (python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())")
MAILBOX_ENCRYPTION_KEY=
# Where Google sends the owner back after Connect Gmail
APP_URL=http://localhost:3000
# Vercel sends this to the daily job
CRON_SECRET=
